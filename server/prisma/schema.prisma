generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?  @map("password_hash")
  googleId     String?  @unique @map("google_id")
  isEmailVerified Boolean @default(false) @map("is_email_verified")
  role         Role     @default(APPLICANT)
  fullName     String   @map("full_name")
  profileImageUrl String? @map("profile_image_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  applications    Application[]
  notifications   Notification[]
  activityLogs    ActivityLog[]
  refreshTokens   RefreshToken[]
  communicationLogs CommunicationLog[]
  createdCommunications CommunicationLog[] @relation("CommunicationCreatedBy")
  createdEmailJobs EmailJob[] @relation("EmailJobCreatedBy")
  appeals Appeal[]
  reviewedAppeals Appeal[] @relation("AppealReviewedBy")
  scholarshipRenewals ScholarshipRenewal[]
  assignedExamSchedules ExamSchedule[] @relation("ExamScheduleExaminer")

  @@map("users")
}

enum Role {
  APPLICANT
  ADMIN
  REVIEWER
  SCHEDULER
  SUPER_ADMIN
}

model Application {
  id          String            @id @default(uuid())
  applicantId String            @map("applicant_id")
  applicant   User              @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  status      ApplicationStatus @default(PENDING_REVIEW)

  // Personal Info
  lastName     String?  @map("last_name")
  firstName    String?  @map("first_name")
  middleName   String?  @map("middle_name")
  placeOfBirth String?  @map("place_of_birth")
  birthdate    DateTime? @map("birthdate")
  sex          String?
  gender       String?
  age          Int?
  address      String?
  contact      String?
  school       String?
  course       String?
  yearLevel    Int?    @map("year_level")

  // Family Info
  fatherName       String?  @map("father_name")
  fatherOccupation String?  @map("father_occupation")
  motherName       String?  @map("mother_name")
  motherOccupation String?  @map("mother_occupation")
  numDependents    Int?     @map("num_dependents")
  familyIncome     Decimal? @db.Decimal(12, 2) @map("family_income")
  incomeSource     String?  @map("income_source")

  // Academic
  schoolAddress      String?  @map("school_address")
  yearGraduated      Int?     @map("year_graduated")
  generalAverage     Decimal? @db.Decimal(5, 2) @map("general_average")
  collegePreferences Json?    @map("college_preferences")
  soloParent         Boolean? @map("solo_parent")
  fourPs             Boolean? @map("four_ps")
  priorScholarship   Boolean? @map("prior_scholarship")
  scholarshipType    String?  @map("scholarship_type")
  gwa                Decimal?  @db.Decimal(4, 2)
  achievements       String?

  // Admin
  adminRemarks   String?   @map("admin_remarks")
  examScore      Decimal?  @db.Decimal(5, 2) @map("exam_score")
  interviewScore Decimal?  @db.Decimal(5, 2) @map("interview_score")
  /// @deprecated Use ExamSchedule.scheduledAt — this field is no longer written and will be removed in a future migration.
  interviewDate  DateTime? @map("interview_date")
  interviewNotes String?   @map("interview_notes")
  rejectionReason String?  @map("rejection_reason")
  academicYear    String?  @map("academic_year")
  requirementChecklist Json? @map("requirement_checklist")

  submittedAt DateTime  @default(now()) @map("submitted_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  requirementFiles    RequirementFile[]
  corFiles            CorFile[]
  notifications       Notification[]
  activityLogs        ActivityLog[]
  examSchedules       ExamSchedule[]
  communicationLogs   CommunicationLog[]
  appeals             Appeal[]
  scholarshipRenewals ScholarshipRenewal[]

  @@unique([applicantId])
  @@index([status])
  @@index([submittedAt])
  @@index([academicYear])
  @@map("applications")
}

enum ApplicationStatus {
  PENDING_REVIEW
  INCOMPLETE
  ELIGIBILITY_SCREENING
  NOT_QUALIFIED
  EXAM_INTERVIEW
  FAILED_EXAM
  APPROVED
  COR_SUBMITTED
  COR_REJECTED
  ACCEPTED
  REJECTED
}

model RequirementFile {
  id            String   @id @default(uuid())
  applicationId String   @map("application_id")
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fileName      String   @map("file_name")
  fileUrl       String   @map("file_url")
  fileType      String?  @map("file_type")
  uploadedAt    DateTime @default(now()) @map("uploaded_at")

  @@map("requirement_files")
}

model CorFile {
  id            String   @id @default(uuid())
  applicationId String   @map("application_id")
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fileName      String   @map("file_name")
  fileUrl       String   @map("file_url")
  uploadedAt    DateTime @default(now()) @map("uploaded_at")
  reviewedAt    DateTime? @map("reviewed_at")
  isApproved    Boolean?  @map("is_approved")

  @@map("cor_files")
}

model Notification {
  id            String           @id @default(uuid())
  userId        String           @map("user_id")
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String?          @map("application_id")
  application   Application?     @relation(fields: [applicationId], references: [id])
  title         String
  message       String
  type          NotificationType @default(INFO)
  isRead        Boolean          @default(false) @map("is_read")
  createdAt     DateTime         @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@index([applicationId])
  @@map("notifications")
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

model ActivityLog {
  id            String   @id @default(uuid())
  applicationId String?  @map("application_id")
  application   Application? @relation(fields: [applicationId], references: [id])
  performedById String?  @map("performed_by")
  performedBy   User?    @relation(fields: [performedById], references: [id])
  action        String
  fromStatus    String?  @map("from_status")
  toStatus      String?  @map("to_status")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([applicationId])
  @@map("activity_logs")
}

model CommunicationLog {
  id            String                  @id @default(uuid())
  applicationId String?                 @map("application_id")
  application   Application?            @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  userId        String?                 @map("user_id")
  user          User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  channel       CommunicationChannel
  direction     CommunicationDirection  @default(OUTBOUND)
  subject       String?
  message       String?
  metadata      Json?
  createdById   String?                 @map("created_by_id")
  createdBy     User?                   @relation("CommunicationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime                @default(now()) @map("created_at")

  @@index([applicationId, createdAt])
  @@index([userId, createdAt])
  @@map("communication_logs")
}

enum CommunicationChannel {
  EMAIL
  IN_APP
  PORTAL_NOTICE
  SMS
}

enum CommunicationDirection {
  INBOUND
  OUTBOUND
}

enum EmailJobStatus {
  PENDING
  PROCESSING
  RETRY
  FAILED
  COMPLETED
}

model EmailJob {
  id          String         @id @default(uuid())
  type        String
  status      EmailJobStatus @default(PENDING)
  payload     Json
  createdById String?  @map("created_by_id")
  createdBy   User?    @relation("EmailJobCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  runAt       DateTime @map("run_at")
  attempts    Int      @default(0)
  maxAttempts Int      @default(3) @map("max_attempts")
  lastError   String?  @map("last_error")
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status, runAt])
  @@map("email_jobs")
}

enum AppealStatus {
  PENDING
  APPROVED
  DENIED
}

model Appeal {
  id            String       @id @default(uuid())
  applicationId String       @map("application_id")
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicantId   String       @map("applicant_id")
  applicant     User         @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  reason        String
  status        AppealStatus @default(PENDING)
  resolution    String?
  reviewedById  String?      @map("reviewed_by_id")
  reviewedBy    User?        @relation("AppealReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@index([applicationId, status])
  @@index([applicantId, createdAt])
  @@map("appeals")
}

model ExamSchedule {
  id            String         @id @default(uuid())
  applicationId String         @map("application_id")
  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  examinerId    String?        @map("examiner_id")
  examiner      User?          @relation("ExamScheduleExaminer", fields: [examinerId], references: [id], onDelete: SetNull)
  scheduledAt   DateTime       @map("scheduled_at")
  location      String?
  type          ScheduleType   @default(BOTH)
  status        ScheduleStatus @default(SCHEDULED)
  createdAt     DateTime       @default(now()) @map("created_at")

  @@index([examinerId])
  @@map("exam_schedules")
}

enum ScheduleType {
  EXAM
  INTERVIEW
  BOTH
}

enum ScheduleStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model CarouselSlide {
  id        String   @id @default(uuid())
  imageUrl  String   @map("image_url")
  label     String
  caption   String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("carousel_slides")
}

model SiteSetting {
  id                      String   @id @default("default")
  facebookPageName        String?  @map("facebook_page_name")
  facebookPageUrl         String?  @map("facebook_page_url")
  facebookPageDescription String?  @map("facebook_page_description")
  gwaThreshold            Decimal  @default(83) @db.Decimal(4, 2) @map("gwa_threshold")
  applicationOpen         Boolean  @default(true) @map("application_open")
  applicationDeadline     DateTime? @map("application_deadline")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("refresh_tokens")
}

enum RenewalStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model ScholarshipRenewal {
  id            String        @id @default(uuid())
  applicantId   String        @map("applicant_id")
  applicant     User          @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  applicationId String        @map("application_id")
  application   Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status        RenewalStatus @default(PENDING_REVIEW)
  academicYear  String?       @map("academic_year")
  adminRemarks  String?       @map("admin_remarks")
  submittedAt   DateTime      @default(now()) @map("submitted_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  renewalFiles  RenewalFile[]

  @@index([applicantId, status])
  @@map("scholarship_renewals")
}

model RenewalFile {
  id         String             @id @default(uuid())
  renewalId  String             @map("renewal_id")
  renewal    ScholarshipRenewal @relation(fields: [renewalId], references: [id], onDelete: Cascade)
  fileName   String             @map("file_name")
  fileUrl    String             @map("file_url")
  fileType   String?            @map("file_type")
  docType    String             @map("doc_type")
  uploadedAt DateTime           @default(now()) @map("uploaded_at")

  @@map("renewal_files")
}

